# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Le port sur lequel le serveur local va s'exécuter (ex: 3000, 8080)
PORT=3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL, MySQL, etc.)
# ------------------------------------------------------------------------------
# L'adresse du serveur de base de données (ex: localhost, 127.0.0.1 ou IP distante)
DB_HOST=localhost
# Le nom de la base de données à utiliser
DB_NAME=mon_db
# Le mot de passe de l'utilisateur de la base de données
DB_PASSWORD=fkqmsfjsqdlmjfqsdf
# Le port de connexion à la base de données (ex: 5432 pour Postgres, 3306 pour MySQL)
DB_PORT=5432
# Le nom d'utilisateur de la base de données (ex: root, postgres)
DB_USERNAME=postgres

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Clé secrète unique utilisée pour signer et vérifier les JSON Web Tokens (JWT)
JWT_KEY=itachi
# Le nombre de "rounds" ou coût pour le hachage des mots de passe avec Bcrypt (ex: 10)
SALT_BCRYPT=9

# ------------------------------------------------------------------------------
# MAIL SERVER CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
# L'adresse du serveur SMTP (ex: ://gmail.com, mail.mailtrap.io)
MAIL_HOST=smtp.gmail.com
# Le port du serveur SMTP (ex: 465 pour SSL, 587 pour TLS, 25)
MAIL_PORT=587

# ------------------------------------------------------------------------------
# EMAIL CREDENTIALS & SENDER
# ------------------------------------------------------------------------------
# L'adresse email visible qui apparaît comme envoyeur des messages (ex: no-reply@monentreprise.com)
EMAIL_EXPEDITEUR=
# Le mot de passe de l'adresse email (ou mot de passe d'application si 2FA activé)
EMAIL_MDP=
# L'identifiant ou l'adresse email de connexion au serveur de messagerie
EMAIL_USER=
